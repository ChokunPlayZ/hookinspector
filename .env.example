PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/hookinspector.sqlite
# Set this to the externally reachable URL in production (no trailing slash).
# PUBLIC_URL=https://hooks.example.com
# For compose.production.yaml, also set DOMAIN (without https://).
# DOMAIN=hooks.example.com
DEFAULT_TTL_HOURS=24
MAX_BODY_BYTES=1048576
MAX_REQUESTS_PER_INBOX=100
MAX_INBOXES=1000
MAX_STORAGE_BYTES=268435456
MAX_CONCURRENT_UPLOADS=32
CREATE_RATE_LIMIT=10
WEBHOOK_RATE_LIMIT=120
# Enable only behind a trusted proxy; restrict direct access to the app port.
# One directly connected reverse proxy = 1. Do not enable on an unprotected port.
TRUST_PROXY_HOPS=0
# Set true when serving over HTTPS (including behind a TLS-terminating proxy).
COOKIE_SECURE=false
